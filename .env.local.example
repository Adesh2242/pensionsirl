# Copy to .env.local and fill in what you need. Every variable is optional:
# without them the app runs in demo mode (sample funds, accounts stored in
# the browser, templated AI replies). See README.md → "Enabling real services".
#
# Production values live in Netlify → Site configuration → Environment
# variables, not in this file. Never commit .env.local.

# ── Supabase: real accounts, portfolios and the live fund catalog ──────────
# Project URL and the publishable (anon) key — both are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret. Server-only: account deletion and the fund scraper's writes.
# Supabase → Project Settings → API Keys → service_role / secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI suggestions ─────────────────────────────────────────────────────────
# Without it, /ai-suggestions returns templated replies from the catalog.
GEMINI_API_KEY=

# ── Rate limiting ──────────────────────────────────────────────────────────
# Durable limits on the AI route; falls back to in-memory without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Site ───────────────────────────────────────────────────────────────────
# Your real domain, for metadata, sitemap and robots. Defaults to https://pensioniq.ie.
NEXT_PUBLIC_SITE_URL=
