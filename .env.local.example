# Copy to .env.local for `pnpm dev`. Production values live in Railway →
# project → service → Variables, never in this file. Never commit .env.local.
#
# Easiest local setup: `docker compose up --build` runs Postgres, migrations
# and the site together with no .env file at all.

# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Without it the site shows the bundled sample
# funds and accounts are unavailable. For a local Postgres:
#   DATABASE_URL=postgres://pensioniq:pensioniq@localhost:5432/pensioniq
# then `pnpm migrate` once, and `pnpm scrape:funds` for live fund data.
DATABASE_URL=

# Salt for hashing IP addresses in the cookie-consent log. Any long random string.
CONSENT_HASH_SALT=

# ── Google sign-in (optional) ──────────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <your site>/auth/callback. Both unset = button hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI suggestions (optional) ──────────────────────────────────────────────
# Without it, /ai-suggestions answers from the catalogue with built-in search.
GEMINI_API_KEY=

# ── Email (optional) ───────────────────────────────────────────────────────
# Resend sending-only key: confirmation links and emailed portfolio reports.
# Without it the "email me this report" panel is hidden.
EMAIL_API_KEY=
# EMAIL_FROM=PensionIQ <reports@pensionwise.ie>

# ── Rate limiting (optional) ───────────────────────────────────────────────
# Durable limits across replicas; falls back to in-memory without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Site ───────────────────────────────────────────────────────────────────
# The public address, for metadata, sitemap, robots and Google sign-in.
NEXT_PUBLIC_SITE_URL=
